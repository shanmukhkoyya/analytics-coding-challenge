SELECT * FROM customers;
SELECT * FROM orders;
-- List all customers who have placed at least one order

select distinct c.customer_id, c.name, c.city
from customers c
inner join orders o
where c.customer_id=o.customer_id;

-- Find the total amount spent by each customer

select customer_id,sum(amount) total_amount
from orders
group by customer_id;

-- Display the top 3 customers based on total spending

select customer_id,sum(amount) total_amount
from orders
group by customer_id
order by total_amount desc
limit 3;

-- Retrieve all orders placed in the last 7 days (from latest order date)

SELECT *
FROM orders
WHERE order_date >= DATE_SUB(
    (SELECT MAX(order_date) FROM orders),
    INTERVAL 7 DAY
);

-- Show customers who have never placed an order

select c.customer_id,c.name,c.city
from customers c
left join orders o
on c.customer_id=o.customer_id
where o.order_id is null;

-- Find the restaurant that received the highest number of orders

select restaurant, count(order_id) total_orders
from orders
group by restaurant
order by total_orders desc
limit 1;

--  List customers from “Bengaluru” who spent more than ₹1000

select c.customer_id,c.name,c.city,sum(o.amount) total
from customers c
inner join orders o
on c.customer_id = o.customer_id
where c.city= 'Bengaluru'
group by c.customer_id,c.name,c.city
having sum(o.amount) >1000;

-- Show the total number of orders placed per city

select count(o.order_id) as orders_count, c.city
from customers c
inner join orders o
where c.customer_id = o.customer_id
group by c.city;

-- Find the average order amount for each restaurant

select avg(amount) as avverage_amount, restaurant from orders
group by restaurant;

-- Identify customers who placed more than 5 orders

select count(o.order_id) count_orders, c.customer_id,c.name,c.city
from customers c inner join orders o 
on c.customer_id = o.customer_id
group by c.customer_id,c.name,c.city
having count(o.order_id)>5;
